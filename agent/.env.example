BACKEND_BASE_URL=http://localhost:8080
INTERNAL_API_TOKEN=change-me-internal-token

# Leave CHROMA_HOST empty to use the local persistent store at CHROMA_PATH.
CHROMA_PATH=./chroma
CHROMA_HOST=
CHROMA_PORT=8000

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=60

# Ollama is the local fallback when the cloud model is unavailable.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_CONTEXT_LENGTH=8192

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
